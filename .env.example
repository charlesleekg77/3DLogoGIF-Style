# ── Stripe ────────────────────────────────────────────────────────────────────
# Server-only. Never expose this with a NEXT_PUBLIC_ prefix.
STRIPE_SECRET_KEY=sk_test_replace_me

# Price ids created in the Stripe dashboard. The client only ever sends a tier
# id; these are resolved server-side so a tampered request cannot pick a price.
STRIPE_PRICE_PRO=price_replace_me
STRIPE_PRICE_PRO_ANNUAL=price_replace_me_annual
STRIPE_PRICE_STUDIO=price_replace_me_studio
STRIPE_PRICE_STUDIO_ANNUAL=price_replace_me_studio_annual

# Public origin used to build Stripe success/cancel redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
